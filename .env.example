# Postgres connection string (Neon, Supabase, ou qualquer Postgres) — só a connection string, sem SDK extra.
# No Neon, use a connection string com "-pooler" no host (pooled/PgBouncer) —
# reduz latência de conexão. Ex: ep-xxxx-pooler.c-5.us-east-2.aws.neon.tech
DATABASE_URL="postgresql://user:password@host-pooler:5432/dbname?sslmode=require"

# Auth.js / NextAuth
NEXTAUTH_SECRET="gere-um-valor-aleatorio-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Usados apenas pelo script de seed (prisma/seed.ts) para criar o admin inicial
SEED_ADMIN_NAME="Admin Vertix"
SEED_ADMIN_EMAIL="admin@verticecreate.com"
SEED_ADMIN_PASSWORD="troque-esta-senha"

# Integração Meta Ads (Lead Ads) — ver README seção "Meta Ads". Criados uma
# vez em developers.facebook.com, compartilhados por todos os clientes.
META_APP_ID=""
META_APP_SECRET=""
# Qualquer string secreta sua — usada só para o Meta validar a URL do webhook.
META_WEBHOOK_VERIFY_TOKEN="crie-uma-string-aleatoria"
# Opcional: chave própria pra criptografar os tokens de página no banco.
# Se não definir, usa o NEXTAUTH_SECRET.
META_TOKEN_ENCRYPTION_KEY=""

# Notificações push no navegador (leads novos avisam o cliente no
# celular/computador). Gere um par novo com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:seu-email@dominio.com"

# Integração com Planilha Google (alternativa ao Meta direto — ver README
# seção "Planilha Google"). Conta de serviço criada no Google Cloud Console,
# com a API do Google Sheets ativada. O email dela precisa ser adicionado
# como Editor em cada planilha que os clientes conectarem.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Cole a "private_key" do arquivo JSON da conta de serviço, entre aspas,
# mantendo os "\n" literais (não quebre em linhas de verdade).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Protege a rota /api/cron/sync-google-sheets — qualquer string aleatória
# sua. O Vercel Cron envia isso automaticamente se essa env var existir no
# projeto; um cron externo (ex: cron-job.org) precisa mandar como
# ?token=... na URL.
CRON_SECRET="crie-uma-string-aleatoria"
