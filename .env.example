# Postgres connection string (Neon, Supabase, ou qualquer Postgres) — só a connection string, sem SDK extra.
# No Neon, use a connection string com "-pooler" no host (pooled/PgBouncer) —
# reduz latência de conexão. Ex: ep-xxxx-pooler.c-5.us-east-2.aws.neon.tech
DATABASE_URL="postgresql://user:password@host-pooler:5432/dbname?sslmode=require"

# Auth.js / NextAuth
NEXTAUTH_SECRET="gere-um-valor-aleatorio-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Usados apenas pelo script de seed (prisma/seed.ts) para criar o admin inicial
SEED_ADMIN_NAME="Admin Vertix"
SEED_ADMIN_EMAIL="admin@verticecreate.com"
SEED_ADMIN_PASSWORD="troque-esta-senha"
