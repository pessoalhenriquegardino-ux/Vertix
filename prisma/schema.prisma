generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum MetricSource {
  MANUAL
  CSV_IMPORT
  META_ADS_API // reservado para integração futura, não implementado agora
  WHATSAPP_API // reservado para integração futura, não implementado agora
}

// Registro de tentativas de login (sucesso e falha), usado para rate
// limiting de credential stuffing / brute force. Não guarda a senha, só o
// resultado da tentativa.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  clientId     String? // null quando role = ADMIN
  client       Client?  @relation(fields: [clientId], references: [id])
  createdAt    DateTime @default(now())

  @@index([clientId])
}

model Client {
  id        String        @id @default(cuid())
  name      String
  segment   String?
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  users     User[]
  metrics   DailyMetric[]
  campaignMetrics CampaignMetric[]
  leads           Lead[]
}

// Um registro por cliente por dia (por fonte). É a unidade que alimenta os
// cards e o gráfico de evolução do dashboard.
model DailyMetric {
  id     String @id @default(cuid())
  clientId String
  client Client @relation(fields: [clientId], references: [id])
  date   DateTime // dia de referência do dado (meia-noite UTC)

  adSpend         Decimal @default(0) @db.Decimal(12, 2) // valor gasto de campanha no dia
  leadsGenerated  Int     @default(0) // "Nova Conversa"
  leadsInAnalysis Int     @default(0) // "Análise"
  leadsQualified  Int     @default(0) // "Qualificado"
  leadsProposal   Int     @default(0) // "Proposta"
  leadsWon        Int     @default(0) // "Sucesso"
  leadsLost       Int     @default(0) // "Perdas" (não respondeu / não qualificado)

  source MetricSource @default(MANUAL)

  // Reservado para integração futura (id da campanha/conversa numa API externa,
  // ex: Meta Marketing API ou WhatsApp Business API). Não usado hoje.
  externalRef String?
  notes       String?

  createdByUserId String
  createdAt       DateTime @default(now())

  @@unique([clientId, date, source])
  @@index([clientId, date])
}

// Métricas de performance de anúncios (estilo Meta Ads), por campanha, por dia.
// Complementa o DailyMetric (que registra o pipeline de leads) com os números
// que a plataforma de anúncios entrega: impressões, cliques, CTR, CPC, CPM etc.
model CampaignMetric {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id])
  date         DateTime // dia de referência (meia-noite UTC)
  campaignName String   @default("Geral")

  amountSpent   Decimal @default(0) @db.Decimal(12, 2)
  impressions   Int     @default(0)
  clicks        Int     @default(0)
  ctr           Decimal @default(0) @db.Decimal(8, 4) // % — se não vier no CSV, é calculado (clicks/impressions)
  cpc           Decimal @default(0) @db.Decimal(12, 4) // custo por clique
  cpm           Decimal @default(0) @db.Decimal(12, 4) // custo por mil impressões
  reach         Int?
  frequency     Decimal? @db.Decimal(8, 4)
  results       Int     @default(0) // conversões/resultados reportados pela plataforma
  costPerResult Decimal @default(0) @db.Decimal(12, 4)

  source MetricSource @default(MANUAL)
  // Reservado para integração futura (id da campanha na Meta Marketing API).
  externalRef String?

  createdByUserId String
  createdAt       DateTime @default(now())

  @@unique([clientId, date, campaignName, source])
  @@index([clientId, date])
}

enum LeadStage {
  NEW // Nova Conversa
  IN_ANALYSIS // Análise
  QUALIFIED // Qualificado
  PROPOSAL // Proposta
  WON // Sucesso
  LOST // Perdas
}

enum ActivityType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  NOTE
}

enum ActivityOutcome {
  RESPONDED // Respondeu
  NOT_RESPONDED // Não respondeu
  SCHEDULED // Agendou
  NOT_INTERESTED // Desinteressado
  NO_ANSWER // Sem resposta
}

// Lead individual dentro do CRM do cliente (Kanban). Complementa o
// DailyMetric agregado com o acompanhamento lead-a-lead.
model Lead {
  id       String    @id @default(cuid())
  clientId String
  client   Client    @relation(fields: [clientId], references: [id])

  name  String
  phone String?
  email String?
  source String? // origem do lead (ex: Meta Ads, indicação, orgânico)
  stage LeadStage @default(NEW)
  value Decimal?  @db.Decimal(12, 2) // valor potencial/fechado do negócio

  assignedToUserId String?
  notes            String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  activities LeadActivity[]

  @@index([clientId, stage])
}

// Cadência de contato: histórico de atividades feitas + próximos passos
// agendados para cada lead.
model LeadActivity {
  id     String       @id @default(cuid())
  leadId String
  lead   Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type   ActivityType

  note        String?
  scheduledAt DateTime? // próxima ação de cadência agendada (follow-up)
  completedAt DateTime? // quando a atividade foi de fato realizada
  outcome     ActivityOutcome? // resultado do contato, quando concluído

  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([leadId])
  @@index([scheduledAt])
}
